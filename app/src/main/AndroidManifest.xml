    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates（实况通知）：声明后系统才允许把进度通知推广为实况窗 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- 链接分发「整理规则」的未安装应用检测要按任意用户自填包名查安装状态：
         Android 11+ 包可见性下，查任意包名必须声明 QUERY_ALL_PACKAGES（<queries> 只能声明固定包名/意图，覆盖不了自填包名）。
         查询纯本地进行，结果只用于整理面板的计数展示，不出设备 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher_day"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_day"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiuixBrowser"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MiuixBrowser">
            <!-- 响应系统里的 http(s) 链接 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- 「添加到桌面」生成的轻应用：独立任务、无底栏；同一网址再次点图标回到已打开的那一个 -->
        <activity
            android:name=".WebAppActivity"
            android:exported="false"
            android:documentLaunchMode="intoExisting"
            android:autoRemoveFromRecents="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MiuixBrowser" />

        <!-- 新建下载悬浮弹窗（fork.5）：透明主题 -->
        <!-- 下载弹窗：接收口 + 弹窗二合一（fork.7 按 ABDM 结构）——系统按 intent-filter 直接唤起。
             fork.19：与主界面合回同一任务（回到默认亲和，不再设独立 taskAffinity）——
             fork.17 拆独立任务是怀疑任务归属让弹窗不可见，后经 fork.18 证明真凶是 miuix
             覆盖层组件、已换普通内联面板；同任务后跳板转交只发生一次窗口切换、无中间黑闪，
             与 ABDM 的跳板+弹窗同任务一跳到位同款 -->
        <activity
            android:name=".DownloadDialogActivity"
            android:exported="true"
            android:label="下载"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Marea.Translucent">

            <!-- 分享入口：SEND + 任意 MIME，正文里抽链接 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- 按 MIME 入口：VIEW http/https + 任意类型 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="*/*" />
            </intent-filter>

